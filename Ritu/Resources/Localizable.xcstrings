    "trips.sample.caption": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "西班牙与葡萄牙，含多段机票、跨城转机和两地住宿。不会在安装时自动加入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spain and Portugal, with a connecting flight, a hop between cities, and two stays. It is not added automatically on a fresh install."
          }
        }
      }
    },
