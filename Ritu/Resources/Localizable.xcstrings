    "trip.delete.message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行程、住宿和交通都会从这台设备上移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plan, stays and transfers will be removed from this device."
          }
        }
      }
    },
    "trips.empty.title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有旅行"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trips yet"
          }
        }
      }
    },
    "trips.empty.body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写下日期和城市，再把机票、住宿和想去的地方放进同一张地图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with dates and cities, then place flights, stays and sights on one map."
          }
        }
      }
    },
    "trips.sample.load": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "载入示例行程"
